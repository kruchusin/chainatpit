rules_version = '2';

// Permissions mirror firestore.rules (users/staff/news/departments).
// Reads are public; writes need an active (not disabled) users doc.
service firebase.storage {
  match /b/{bucket}/o {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function me() {
      return firestore.get(userPath()).data;
    }

    function isActive() {
      return isSignedIn()
        && firestore.exists(userPath())
        && me().get('disabled', false) != true;
    }

    function isAdmin() {
      return isActive() && me().get('role', '') == 'admin';
    }

    function isCentral() {
      return isAdmin() || (isActive() && me().get('role', '') == 'pr_central');
    }

    function prDepts() {
      return me().get('prDepartments', []);
    }

    function ownsDept(id) {
      return isActive() && (id in prDepts());
    }

    // upload constraints: <= 2 MB and an image content type
    function validUpload() {
      return request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ---------- permission per path ----------
    function canWriteNews(newsId) {
      return isCentral()
        || (isActive()
            && firestore.exists(/databases/(default)/documents/news/$(newsId))
            && firestore.get(/databases/(default)/documents/news/$(newsId))
                 .data.get('departmentIds', []).size() > 0
            && firestore.get(/databases/(default)/documents/news/$(newsId))
                 .data.get('departmentIds', []).hasOnly(prDepts()));
    }

    function canWriteStaff(staffId) {
      return isAdmin()
        || (isActive()
            && firestore.exists(/databases/(default)/documents/staff/$(staffId))
            && (firestore.get(/databases/(default)/documents/staff/$(staffId))
                  .data.get('uid', null) == request.auth.uid
                || firestore.get(/databases/(default)/documents/staff/$(staffId))
                  .data.get('departmentIds', []).hasAny(prDepts())));
    }

    function canWriteDept(deptId) {
      return isAdmin() || ownsDept(deptId);
    }

    // ---------- paths ----------
    match /news/{newsId}/{file} {
      allow read: if true;
      allow create, update: if canWriteNews(newsId) && validUpload();
      allow delete: if canWriteNews(newsId);
    }

    match /staff/{staffId}/photo.jpg {
      allow read: if true;
      allow create, update: if canWriteStaff(staffId) && validUpload();
      allow delete: if canWriteStaff(staffId);
    }

    match /departments/{deptId}/{file} {
      allow read: if true;
      allow create, update: if canWriteDept(deptId) && validUpload();
      allow delete: if canWriteDept(deptId);
    }

    match /site/{file} {
      allow read: if true;
      allow create, update: if isAdmin() && validUpload();
      allow delete: if isAdmin();
    }

    // default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
