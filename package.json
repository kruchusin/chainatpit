{
  "name": "chainatpit-school-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --port 8788 --r2=MEDIA",
    "seed:emu": "node scripts/seed.mjs --emulator",
    "test:unit": "vitest run --project unit",
    "test:rules": "firebase emulators:exec --project demo-chainatpit --only firestore \"vitest run --project rules\"",
    "test:e2e": "firebase emulators:exec --project demo-chainatpit --only auth,firestore \"playwright test\"",
    "test": "npm run test:unit && npm run test:rules && npm run test:e2e"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@firebase/rules-unit-testing": "^4.0.0",
    "@playwright/test": "^1.49.0",
    "dompurify": "^3.2.0",
    "firebase": "^11.0.0",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^14.0.0",
    "jsdom": "^25.0.0",
    "node-html-parser": "^6.1.13",
    "sharp": "^0.33.5",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
