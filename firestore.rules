rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers (reused by later rule sections) ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // users/{uid}.data of the caller (only call after isSignedIn())
    function me() {
      return get(userPath()).data;
    }

    // signed in, has a users doc, and not disabled
    function isActive() {
      return isSignedIn()
        && exists(userPath())
        && me().get('disabled', false) != true;
    }

    function isAdmin() {
      return isActive() && me().get('role', '') == 'admin';
    }

    function isPrCentral() {
      return isActive() && me().get('role', '') == 'pr_central';
    }

    // [] when the field is missing
    function prDepts() {
      return me().get('prDepartments', []);
    }

    function ownsDept(id) {
      return isActive() && (id in prDepts());
    }

    // ---------- scoped-writer helpers (news, documents) ----------
    function isCentral() {
      return isAdmin() || isPrCentral();
    }

    // active dept PR who is responsible for EVERY id, and ids is non-empty
    function deptsWritable(ids) {
      return isActive() && ids.size() > 0 && ids.hasOnly(prDepts());
    }

    function canCreateScoped(newIds) {
      return isCentral() || deptsWritable(newIds);
    }

    // both old and new scope must belong to the writer (no pulling foreign docs in)
    function canUpdateScoped(oldIds, newIds) {
      return isCentral() || (deptsWritable(oldIds) && deptsWritable(newIds));
    }

    function canDeleteScoped(oldIds) {
      return isCentral() || deptsWritable(oldIds);
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ---------- settings ----------
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- departments ----------
    match /departments/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (ownsDept(id)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['description', 'coverUrl']));
    }

    // ---------- staff ----------
    match /staff/{id} {
      // whole-document allow-list (no phone: PDPA)
      function staffKeysOk() {
        return request.resource.data.keys().hasOnly(
          ['prefix', 'name', 'position', 'photoUrl', 'bio', 'education',
           'email', 'departmentIds', 'uid', 'order', 'active']);
      }

      function staffChanged() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function isStaffSelf() {
        return isActive() && resource.data.uid == request.auth.uid;
      }

      // PR of a department the staff currently belongs to (call only with isActive())
      function isStaffPr() {
        return isActive() && resource.data.departmentIds.hasAny(prDepts());
      }

      // Public may read active staff (queries must filter active == true).
      allow read: if resource.data.active == true
        || isAdmin()
        || isStaffSelf()
        || isStaffPr();

      allow create: if isAdmin() && staffKeysOk();
      allow delete: if isAdmin();

      allow update: if staffKeysOk() && (
        isAdmin()
        || (isStaffSelf()
            && staffChanged().hasOnly(['photoUrl', 'bio', 'education', 'email']))
        || (isStaffPr()
            && !staffChanged().hasAny(['uid'])
            && resource.data.departmentIds.toSet()
                 .difference(request.resource.data.departmentIds.toSet())
                 .hasOnly(prDepts())
            && request.resource.data.departmentIds.toSet()
                 .difference(resource.data.departmentIds.toSet())
                 .hasOnly(prDepts()))
      );
    }

    // ---------- news ----------
    match /news/{id} {
      function newsKeysOk() {
        return request.resource.data.keys().hasOnly(
          ['title', 'bodyHtml', 'coverUrl', 'images', 'departmentIds', 'pinned',
           'published', 'authorUid', 'createdAt', 'updatedAt']);
      }

      function newIds() {
        return request.resource.data.get('departmentIds', []);
      }

      function oldIds() {
        return resource.data.get('departmentIds', []);
      }

      // only admin/pr_central may turn pinned on; others may keep an existing true
      function pinnedOk(wasPinned) {
        return isCentral()
          || request.resource.data.get('pinned', false) != true
          || wasPinned == true;
      }

      // get: public reads published; staff read per-document scope.
      allow get: if resource.data.get('published', false) == true
        || isCentral()
        || (isActive() && oldIds().hasAny(prDepts()))
        || (isActive() && resource.data.get('authorUid', null) == request.auth.uid);

      // list: queries must be provable, so use plain field access (no .get()).
      // Public lists must filter published == true. NOTE: any active dept PR
      // (non-empty prDepartments) may list other departments' drafts. This is
      // accepted (internal staff; the UI filters by department).
      allow list: if resource.data.published == true
        || isCentral()
        || (isActive() && prDepts().size() > 0)
        || (isActive() && resource.data.authorUid == request.auth.uid);

      allow create: if isActive()
        && newsKeysOk()
        && request.resource.data.get('authorUid', null) == request.auth.uid
        && pinnedOk(false)
        && canCreateScoped(newIds());

      allow update: if isActive()
        && newsKeysOk()
        && request.resource.data.get('authorUid', null) == resource.data.get('authorUid', null)
        && pinnedOk(resource.data.get('pinned', false))
        && canUpdateScoped(oldIds(), newIds());

      allow delete: if isActive() && canDeleteScoped(oldIds());
    }

    // ---------- documents ----------
    match /documents/{id} {
      function docKeysOk() {
        return request.resource.data.keys().hasOnly(
          ['title', 'url', 'category', 'departmentId', 'year', 'order']);
      }

      // departmentId (string|null) viewed as a 0/1-element list
      function docIds(d) {
        return d.get('departmentId', null) == null ? [] : [d.departmentId];
      }

      allow read: if true;

      allow create: if isActive()
        && docKeysOk()
        && canCreateScoped(docIds(request.resource.data));

      allow update: if isActive()
        && docKeysOk()
        && canUpdateScoped(docIds(resource.data), docIds(request.resource.data));

      allow delete: if isActive() && canDeleteScoped(docIds(resource.data));
    }

    // default deny: anything not matched above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
